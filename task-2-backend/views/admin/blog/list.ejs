<div class="admin-table">
    <h1>Manage Blog Posts</h1>
    <a href="/admin/blog/create" class="btn btn-primary">+ New Post</a>
    <table>
        <thead>
            <tr><th>ID</th><th>Title</th><th>Category</th><th>Created</th><th>Actions</th></tr>
        </thead>
        <tbody>
            <% posts.forEach(post => { %>
                <tr>
                    <td><%= post.id %></td>
                    <td><%= post.title %></td>
                    <td><%= post.Category ? post.Category.name : '-' %></td>
                    <td><%= post.createdAt.toDateString() %></td>
                    <td>
                        <a href="/admin/blog/edit/<%= post.id %>">Edit</a>
                        <form action="/admin/blog/delete/<%= post.id %>" method="POST" style="display:inline;">
                            <button type="submit" onclick="return confirm('Delete?')">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
<div class="admin-table">
    <h1>Manage Services</h1>
    <table>
        <thead><tr><th>ID</th><th>Name</th><th>Slug</th><th>Actions</th></tr></thead>
        <tbody>
            <% services.forEach(service => { %>
                <tr>
                    <td><%= service.id %></td>
                    <td><%= service.name %></td>
                    <td><%= service.slug %></td>
                    <td>
                        <a href="/admin/services/edit/<%= service.id %>">Edit</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</div>
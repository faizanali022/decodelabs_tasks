<%- include('../partials/head') %>
<%- include('../partials/topbar') %>

<main class="contact-page">
    <!-- Hero Section -->
    <section class="contact-hero">
        <div class="container">
            <h1>Contact Us – Get in Touch</h1>
            <p class="tagline">Have questions or ready to hire? Reach out to us anytime.</p>
        </div>
    </section>

    <div class="container">
        <!-- Contact Grid: Info & Form -->
        <div class="contact-grid">
            <!-- Contact Info Cards -->
            <div class="contact-info">
                <div class="info-card">
                    <div class="card-icon"><i class="fas fa-phone-alt"></i></div>
                    <div>
                        <h3>Call Us</h3>
                        <a href="tel:03177799786">0317 7799786</a>
                    </div>
                </div>
                <div class="info-card">
                    <div class="card-icon"><i class="fab fa-whatsapp"></i></div>
                    <div>
                        <h3>WhatsApp</h3>
                        <a href="https://wa.me/923177799786">0317 7799786</a>
                    </div>
                </div>
                <div class="info-card">
                    <div class="card-icon"><i class="fas fa-envelope"></i></div>
                    <div>
                        <h3>Email</h3>
                        <a href="mailto:info@yourwebsite.com">info@yourwebsite.com</a>
                    </div>
                </div>
                <div class="info-card">
                    <div class="card-icon"><i class="fas fa-clock"></i></div>
                    <div>
                        <h3>Response Time</h3>
                        <p>Within 15 minutes during business hours</p>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="contact-form">
                <h2>Send Us a Message</h2>
                <div id="formMessage" style="display:none; padding: 15px; margin-bottom: 20px; border-radius: 5px;"></div>
                <form id="contactForm">
                    <input type="text" name="fullname" placeholder="Full Name" required>
                    <input type="email" name="email" placeholder="Email Address" required>
                    <input type="tel" name="phone" placeholder="Phone Number" required>
                    <select name="service" required>
                        <option value="">Select Service</option>
                        <option value="Maid">Maid Service</option>
                        <option value="Babysitter">Babysitter Service</option>
                        <option value="Cook">Cook / Chef Service</option>
                        <option value="Driver">Driver Service</option>
                        <option value="Security">Security Guard Service</option>
                        <option value="PatientCare">Patient Care Service</option>
                        <option value="Helper">Helper Service</option>
                    </select>
                    <textarea name="message" placeholder="Your Message" rows="5" required></textarea>
                    <button type="submit" class="btn-primary" id="submitBtn">Send Message</button>
                </form>
            </div>
        </div>

        <!-- Cities Served Section -->
        <div class="cities-serving">
            <h2>We Serve in These Cities</h2>
            <div class="city-badges">
                <span>Islamabad</span>
                <span>Rawalpindi</span>
            </div>
            <p class="city-note">We have local coordination teams in all cities for quick response.</p>
        </div>

        <!-- Quick Response Guarantee -->
        <div class="quick-response">
            <div class="response-icon"><i class="fas fa-bolt"></i></div>
            <div class="response-text">
                <h3>Quick Response Guaranteed</h3>
                <p>We reply to calls and WhatsApp messages within 15 minutes during business hours (9 AM – 9 PM). For after‑hours inquiries, we will get back to you the next morning.</p>
            </div>
        </div>

        <!-- Office Location Section -->
        <div class="office-location">
            <h2>Our Office Location</h2>
            <div class="location-grid">
                <div class="address-card">
                    <div class="address-icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div class="address-details">
                        <p><strong>Address:</strong> Main Jaffar Chowk, G-11/2 G-11, Islamabad, 43710</p>
                        <p><strong>Phone:</strong> 0317 7799786</p>
                        <p><strong>Hours:</strong> Open 24 hours</p>
                    </div>
                </div>
                <div class="map-container">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3318.506535804876!2d72.998498915296!3d33.725629580689!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38dfa0b5c7d9d0b3%3A0x4c9e8c8c8c8c8c8c!2sMain%20Jaffar%20Chowk%2C%20G-11%2F2%20G-11%2C%20Islamabad%2C%2043710!5e0!3m2!1sen!2s!4v1640000000000!5m2!1sen!2s" 
                        width="100%" 
                        height="250" 
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
    <section class="cta-section">
    <div class="container">
        <h2>Ready to Hire Trusted Home Staff?</h2>
        <p>Get reliable, verified, and trained staff for your home today. One call and we'll handle the rest.</p>
        <div class="cta-buttons">
            <a href="tel:03177799786" class="btn-call">Call Now</a>
            <a href="https://wa.me/923177799786" class="btn-whatsapp">WhatsApp Now</a>
        </div>
    </div>
</section>
</main>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>

<script>
document.getElementById('contactForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const submitBtn = document.getElementById('submitBtn');
    const formMessage = document.getElementById('formMessage');
    const formData = new FormData(document.getElementById('contactForm'));
    
    submitBtn.disabled = true;
    submitBtn.textContent = 'Opening WhatsApp...';
    
    try {
        const response = await fetch('/contact', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(Object.fromEntries(formData))
        });
        
        const result = await response.json();
        
        if (result.success && result.whatsappLink) {
            // Show success message
            formMessage.style.display = 'block';
            formMessage.style.backgroundColor = '#d4edda';
            formMessage.style.color = '#155724';
            formMessage.style.borderLeft = '4px solid #28a745';
            formMessage.textContent = '✅ ' + result.message;
            
            // Reset form
            document.getElementById('contactForm').reset();
            
            // Redirect to WhatsApp after 1 second
            setTimeout(() => {
                window.open(result.whatsappLink, '_blank');
            }, 1000);
        } else {
            formMessage.style.display = 'block';
            formMessage.style.backgroundColor = '#f8d7da';
            formMessage.style.color = '#721c24';
            formMessage.style.borderLeft = '4px solid #dc3545';
            formMessage.textContent = '❌ ' + result.message;
        }
    } catch (error) {
        console.error('Error:', error);
        formMessage.style.display = 'block';
        formMessage.style.backgroundColor = '#f8d7da';
        formMessage.style.color = '#721c24';
        formMessage.style.borderLeft = '4px solid #dc3545';
        formMessage.textContent = '❌ Error processing your message. Please try again.';
    } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
        // Hide message after 5 seconds
        setTimeout(() => {
            formMessage.style.display = 'none';
        }, 5000);
    }
});
</script>
</body>
</html>
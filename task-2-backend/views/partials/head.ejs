<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- Dynamic SEO Meta Tags -->
<meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Professional home staff services across Islamabad and Rawalpindi – verified maids, babysitters, cooks, drivers, and more.' %>"
<meta name="keywords" content="<%= typeof metaKeywords !== 'undefined' ? metaKeywords : 'maid service, babysitter, cook, driver, security guard, patient care, home helper, Islamabad, Rawalpindi' %>"
<meta name="author" content="Al Noor Maid Services Agency">
<meta name="robots" content="index, follow">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' && canonicalUrl ? canonicalUrl : 'https://yourwebsite.com' %>">
<meta property="og:title" content="<%= typeof metaTitle !== 'undefined' ? metaTitle : 'Al Noor Maid Services Agency – Trusted Maids, Babysitters & Cooks' %>">
<meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Professional home staff services across Pakistan' %>">
<meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/images/logo-social.jpg' %>">

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://yourwebsite.com' %>">
<meta property="twitter:title" content="<%= typeof metaTitle !== 'undefined' ? metaTitle : 'Al Noor Maid Services Agency' %>">
<meta property="twitter:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Professional home staff services across Pakistan' %>">
<meta property="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/images/logo-social.jpg' %>">

<title><%= typeof metaTitle !== 'undefined' ? metaTitle : 'Al Noor Maid Services Agency – Trusted Maids, Babysitters & Cooks in Pakistan' %></title>

<!-- Canonical URL -->
<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
<link rel="canonical" href="<%= canonicalUrl %>">
<% } %>

<!-- Favicon -->
<link rel="icon" type="image/jpeg" sizes="64x64" href="/images/favicon.jpg">
<link rel="icon" type="image/jpeg" sizes="256x256" href="/images/favicon.jpg">
<link rel="apple-touch-icon" sizes="256x256" href="/images/favicon.jpg">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet">

<!-- Stylesheets -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/responsive.css">
<link rel="stylesheet" href="/css/chatbot.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- Structured Data / Schema.org -->
<% if (typeof structuredData !== 'undefined') { %>
<script type="application/ld+json">
<%- JSON.stringify(structuredData) %>
</script>
<% } else { %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Home Staff Services",
  "description": "Professional home staff services in Pakistan",
  "url": "https://yourwebsite.com",
  "telephone": "+923177799786",
  "areaServed": ["Islamabad", "Rawalpindi"],
  "serviceType": ["Maid Service", "Babysitting", "Cooking Service", "Driver Service"]
}
</script>
<% } %>
</head>
<body>